# =============================================================================
# CricGeek — environment template
#
# Copy this file to `.env` and fill in the values you need:
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# ONLY the variables under "1. REQUIRED" are needed to boot the app.
# Everything else makes a feature better; when it is missing that feature
# degrades gracefully and `/api/health` tells you what is switched off.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED — the app will not work without these
# -----------------------------------------------------------------------------

# Microsoft SQL Server connection string.
# Local SQL Server Express example:
#   sqlserver://localhost:1433;database=cricgeek;user=sa;password=YourPassword123;encrypt=true;trustServerCertificate=true
# Azure SQL example:
#   sqlserver://myserver.database.windows.net:1433;database=cricgeek;user=admin;password=...;encrypt=true
DATABASE_URL="sqlserver://localhost:1433;database=cricgeek;user=sa;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# Session signing secret. Generate one with:
#   openssl rand -base64 32
# or:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Base URL of this app. Use the real domain in production.
AUTH_URL="http://localhost:3000"

# Allow the host header in non-production. Leave true for local development.
AUTH_TRUST_HOST=true


# -----------------------------------------------------------------------------
# 2. EQS — Expression Quality Score
# -----------------------------------------------------------------------------

# Which language provider the EQS pipeline uses.
#   auto       prefer Gemini, fall back to Ollama, then to deterministic heuristics
#   gemini     force Gemini (pin this for reproducible benchmark runs)
#   ollama     force the self-hosted model
#   heuristic  no model at all; deterministic scoring only
EQS_PROVIDER=auto

# --- Primary language-analysis model (Google Gemini) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Model id. The technical spec names gemini-3.5-flash; override this if your
# Google project exposes a different model id. Verify against Google's model
# list before deploying — an unknown id makes every Gemini call fail and the
# pipeline silently falls back to Ollama or heuristics.
GEMINI_EQS_MODEL="gemini-3.5-flash"
# Cheaper/faster model for high-volume sub-tasks (claim extraction, final
# interpretation). Only point this at a smaller model once your own benchmark
# shows the quality is acceptable.
GEMINI_EQS_FAST_MODEL=""
GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# --- Fallback language model (self-hosted Ollama) ---
# Also used by BQS scoring, commentary polish, and tag generation.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:latest"
OLLAMA_BQS_MODEL="qwen3.5:latest"
OLLAMA_EQS_MODEL=""
# Shared secret if your Ollama sits behind an authenticating proxy.
OLLAMA_SHARED_SECRET=""

# --- External plagiarism provider (spec section 6, stage 8) ---
# Leave EXTERNAL_PLAGIARISM_API_URL empty to disable the stage; the pipeline
# then reports it as "unavailable" and keeps scoring.
# Point this at your provider's scan endpoint, or at a thin adapter of your own.
EXTERNAL_PLAGIARISM_API_URL=""
EXTERNAL_PLAGIARISM_API_KEY=""
EXTERNAL_PLAGIARISM_PROVIDER=""
EXTERNAL_PLAGIARISM_AUTH_HEADER="Authorization"
EXTERNAL_PLAGIARISM_AUTH_SCHEME="Bearer"

# --- Internal plagiarism thresholds ---
# Cosine similarity at or above this flags a near-duplicate.
INTERNAL_DUPLICATE_THRESHOLD=0.85
# How many stored expressions to compare against.
INTERNAL_ORIGINALITY_CANDIDATES=120

# --- EQS stage toggles ---
EQS_CRICKET_VERIFICATION_ENABLED=true
EQS_INTERNAL_PLAGIARISM_ENABLED=true
EQS_EXTERNAL_PLAGIARISM_ENABLED=true
EQS_FINAL_INTERPRETATION_ENABLED=true
EQS_PERSISTENCE_ENABLED=true
# Run EQS as part of /api/scoring/analyze (the publish flow).
EQS_RUN_ON_ANALYZE=true
# Create the EQS tables automatically on first use. Set false after applying
# prisma/eqs_migration.sql by hand.
EQS_AUTO_MIGRATE=true

# --- EQS timeouts (milliseconds) ---
EQS_LANGUAGE_TIMEOUT_MS=45000
EQS_CLAIM_TIMEOUT_MS=25000
EQS_CRICKET_TIMEOUT_MS=30000
EQS_INTERNAL_PLAGIARISM_TIMEOUT_MS=6000
EQS_EXTERNAL_PLAGIARISM_TIMEOUT_MS=20000
EQS_FINAL_INTERPRETATION_TIMEOUT_MS=20000
EQS_PIPELINE_TIMEOUT_MS=110000

# How far the final model may move the deterministic score, in points.
# Keep this small: it is the reproducibility guarantee.
EQS_MAX_MODEL_ADJUSTMENT=6

# Component result cache, to avoid paying twice for the same draft.
EQS_CACHE_TTL_MS=600000
EQS_CACHE_MAX_ENTRIES=200


# -----------------------------------------------------------------------------
# 3. VOICE-TO-COMMENTARY
# -----------------------------------------------------------------------------

# Speech-to-text. Get a key at https://console.deepgram.com
DEEPGRAM_API_KEY=""
DEEPGRAM_MODEL="nova-3"

# End-to-end latency budget. The spec targets ~15-30s or faster.
VOICE_LATENCY_TARGET_MS=30000
VOICE_LATENCY_WARN_MS=15000
VOICE_STT_TIMEOUT_MS=20000
VOICE_TRANSFORM_TIMEOUT_MS=6000

# Allow the browser to stream audio directly to the STT provider using a
# short-lived token from /api/commentary/stt-token.
VOICE_STREAMING_ENABLED=true
VOICE_STREAMING_TOKEN_TTL=60
VOICE_PERSISTENCE_ENABLED=true


# -----------------------------------------------------------------------------
# 4. CRICKET DATA — needed to verify statistical claims
# -----------------------------------------------------------------------------

# SportMonks drives fixtures, live scores, scorecards, and squads. Without it
# the EQS cricket-verification stage has no scorecard to check claims against.
SPORTMONKS_API_TOKEN=""

# Serve mock fixtures when no token is set. Keep false in production.
ALLOW_MOCK_MATCH_DATA=true

# Web search backend for claims the scorecard and warehouse cannot answer.
# Set one: Tavily (https://tavily.com) or Serper (https://serper.dev).
TAVILY_API_KEY=""
SERPER_API_KEY=""

# Historical match warehouse, used for structured historical claims.
FACT_CHECK_HISTORICAL_ENABLED=true


# -----------------------------------------------------------------------------
# 5. OPTIONAL EXTRAS
# -----------------------------------------------------------------------------

# Google sign-in. Callback URL: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cricket news sidebar.
GNEWS_API_KEY=""
THENEWSAPI_API_KEY=""
# Show placeholder headlines when no news key is set.
CRICKET_NEWS_ENABLE_MOCK=true

# Python side-services. Leave unset to run the app without them.
AI_SERVICE_URL=""
INSIGHTS_URL=""
RAG_SERVICE_URL=""
