{
  "name": "cricgeek",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:insights": "python3 -m uvicorn insights_service.main:app --host 127.0.0.1 --port 8010 --reload",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "setup": "npm install && prisma generate && prisma db push",
    "db:push": "prisma generate && prisma db push",
    "db:studio": "prisma studio",
    "eqs:selftest": "tsx scripts/eqs-selftest.mts",
    "eqs:migration": "node scripts/generate-eqs-migration.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.62.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
